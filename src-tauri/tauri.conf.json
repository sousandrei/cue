{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Cue",
	"version": "1.7.0",
	"identifier": "com.sousa.cue",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Cue",
				"width": 1000,
				"height": 800
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": []
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"createUpdaterArtifacts": true,
		"license": "GPL-3.0-only",
		"resources": {
			"../LICENSE.md": "licenses/LICENSE.md",
			"../NOTICE.md": "licenses/NOTICE.md"
		},
		"copyright": "Copyright (c) 2026 Andrei Sousa"
	},
	"plugins": {
		"updater": {
			"endpoints": [
				"https://github.com/sousandrei/cue/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCQzBGODkyMDM5MjY3NkUKUldSdVo1SURrdmpBKzhqUWxkZDN3djFDUjlzT1JpS0xScE1DRGYxMmMxT2k2NzVieXJLRFBsSE4K"
		}
	}
}
